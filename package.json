{
  "name": "dinner-decisions",
  "private": true,
  "description": "Dev tooling only. The website is index.html and has no build step; the store apps wrap it with Capacitor (scripts/build-app.mjs).",
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-dinner-decisions \"node --test tests/rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-dinner-decisions \"playwright test\"",
    "rules:deploy": "firebase deploy --only firestore:rules",
    "test:live": "firebase projects:list && playwright test --config playwright.live.config.mjs",
    "test:app": "node --test tests/app-build.test.mjs",
    "app:build": "node scripts/build-app.mjs && cap sync"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.49.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0",
    "firebase-web-compat": "npm:firebase@10.14.1"
  }
}
